---
import Header from '../components/shell/Header.astro';
import Footer from '../components/shell/Footer.astro';
import { site } from '../config/site';
import type { JsonLd } from '../lib/seo';
import { absoluteUrl, canonicalUrl } from '../lib/seo';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
  schemas?: JsonLd[];
}

const {
  title,
  description = site.description,
  canonical,
  image = site.defaultImage,
  noindex = false,
  schemas = [],
} = Astro.props;

const pageTitle = title.includes(site.owner)
  ? title
  : `${title} | ${site.owner}`;
const canonicalHref = canonical ?? canonicalUrl(Astro.url.pathname);
const imageHref = absoluteUrl(image);
const robots = noindex ? 'noindex,nofollow' : 'index,follow';
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalHref} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.owner} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={imageHref} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageHref} />

    {
      schemas.map((schema) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(schema)}
        />
      ))
    }
    <meta name="theme-color" content="#05070a" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.owner} — Notes`}
      href="/rss.xml"
    />
    <slot name="head" />
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-0 focus:top-0 focus:z-50 focus:bg-ink focus:px-4 focus:py-3 focus:font-mono focus:text-sm focus:text-signal focus:outline-none"
    >
      Skip to content
    </a>
    <div class="flex min-h-screen flex-col">
      <Header />
      <main
        id="main-content"
        class="mx-auto w-full max-w-6xl flex-1 px-5 py-12 sm:px-6 md:py-16"
      >
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
