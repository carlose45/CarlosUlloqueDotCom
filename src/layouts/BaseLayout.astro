---
import { site } from '../config/site';
import type { JsonLd } from '../lib/seo';
import { absoluteUrl, canonicalUrl } from '../lib/seo';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
  schemas?: JsonLd[];
}

const {
  title,
  description = site.description,
  canonical,
  image = site.defaultImage,
  noindex = false,
  schemas = [],
} = Astro.props;

const pageTitle = title.includes(site.owner)
  ? title
  : `${title} | ${site.owner}`;
const canonicalHref = canonical ?? canonicalUrl(Astro.url.pathname);
const imageHref = absoluteUrl(image);
const robots = noindex ? 'noindex,nofollow' : 'index,follow';
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalHref} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.owner} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={imageHref} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageHref} />

    {
      schemas.map((schema) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(schema)}
        />
      ))
    }
    <slot name="head" />
  </head>
  <body>
    <div class="min-h-screen">
      <header class="border-b border-white/10">
        <nav
          class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5"
          aria-label="Primary navigation"
        >
          <a class="font-mono text-sm font-semibold text-signal" href="/">
            Carlos Ulloque
          </a>
          <div class="flex flex-wrap items-center gap-4 text-sm text-slate-300">
            <a href="/about">About</a>
            <a href="/notes">Notes</a>
            <a href="/projects">Projects</a>
            <a href="/labs">Labs</a>
            <a href="/uses">Uses</a>
            <a href="/cv">CV</a>
          </div>
        </nav>
      </header>
      <main class="mx-auto max-w-6xl px-6 py-16">
        <slot />
      </main>
      <footer class="border-t border-white/10">
        <div
          class="mx-auto flex max-w-6xl flex-col gap-2 px-6 py-8 text-sm text-slate-400 md:flex-row md:items-center md:justify-between"
        >
          <p>&copy; {new Date().getFullYear()} Carlos Ulloque.</p>
          <p>Privacy-aware technical writing and engineering notes.</p>
        </div>
      </footer>
    </div>
  </body>
</html>
