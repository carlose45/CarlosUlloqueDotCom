---
import BaseLayout from '../layouts/BaseLayout.astro';
import { personJsonLd } from '../lib/seo';
---

<BaseLayout
  title="Carlos Ulloque | Mission Critical Engineer"
  description="Carlos Ulloque is a Mission Critical Engineer focused on security, infrastructure, and product engineering."
  canonical="https://ulloque.com/"
  schemas={[personJsonLd()]}
>
  <section class="max-w-3xl">
    <p class="font-mono text-sm uppercase tracking-wide text-signal">
      Security & Infrastructure · Product Engineering
    </p>
    <h1 class="mt-5 text-4xl font-semibold text-white md:text-6xl">
      Carlos Ulloque
    </h1>
    <p class="mt-6 text-lg leading-8 text-slate-300">
      Mission Critical Engineer building reliable systems, securing what
      matters, and sharing real-world lessons from infrastructure and product
      engineering.
    </p>
  </section>
</BaseLayout>
