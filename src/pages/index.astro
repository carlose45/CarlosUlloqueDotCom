---
import ButtonLink from '../components/ui/ButtonLink.astro';
import Panel from '../components/ui/Panel.astro';
import TerminalPanel from '../components/ui/TerminalPanel.astro';
import LinkCard from '../components/home/LinkCard.astro';
import SectionHeading from '../components/home/SectionHeading.astro';
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbJsonLd, personJsonLd, websiteJsonLd } from '../lib/seo';

const focusAreas = [
  {
    title: 'Mission Critical Systems',
    description:
      'Continuity and recovery for systems that have to keep running. Designed around failure domains and the path back to service, not just the path that works.',
  },
  {
    title: 'Security & Infrastructure',
    description:
      'Secure defaults, explicit trust boundaries, and a smaller blast radius. Access and privacy decided before they turn into incidents.',
  },
  {
    title: 'Product Engineering',
    description:
      'Software built under real constraints. Controlled complexity, clear ownership, and behavior that stays predictable as it grows.',
  },
];

const recentNotes = [
  {
    href: '/notes',
    eyebrow: 'Notes',
    title: 'Designing private routes with Zero Trust',
    description:
      'What Cloudflare Access actually gates, where the bypass gaps are, and the misconfigurations that quietly leave a route open.',
  },
  {
    href: '/notes',
    eyebrow: 'Notes',
    title: 'Cloudflare Access, Java, and JWT validation',
    description:
      'Validating Access identity at the origin, with the origin locked down so the gate cannot be bypassed.',
  },
  {
    href: '/notes',
    eyebrow: 'Notes',
    title: 'Client-side encrypted systems',
    description:
      'Designing so the server holds ciphertext it cannot read — and being honest about the recovery tradeoffs that creates.',
  },
];

const featuredProjects = [
  {
    href: '/projects',
    eyebrow: 'Project',
    title: 'DontTell',
    description:
      'Sharing where the key never reaches the server. Central trust stays minimal and stored data is short-lived by design.',
  },
  {
    href: '/projects',
    eyebrow: 'Project',
    title: 'Vault',
    description:
      'Storage where the provider cannot read the contents. Local ownership of keys, explicit recovery, and no hidden escrow.',
  },
  {
    href: '/labs',
    eyebrow: 'Lab',
    title: 'Zero Trust access experiments',
    description:
      'Comparing access models for private routes — where each one actually gates traffic, and where it only appears to.',
  },
];
---

<BaseLayout
  title="Carlos Ulloque | Mission Critical Engineer"
  description="Carlos Ulloque — Mission Critical Engineer. Operating Oracle infrastructure under pressure, designing for recovery and graceful degradation, and keeping trust and exposure small."
  canonical="https://ulloque.com/"
  schemas={[
    personJsonLd(),
    websiteJsonLd(),
    breadcrumbJsonLd([{ name: 'Carlos Ulloque', path: '/' }]),
  ]}
>
  <div class="home-cinematic">
    <section
      class="home-hero grid gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:items-center"
    >
      <div class="max-w-3xl">
        <p
          class="home-kicker font-mono text-sm uppercase tracking-[0.22em] text-signal"
        >
          {site.positioning}
        </p>
        <h1
          class="home-title mt-6 text-5xl font-semibold leading-tight text-ink-text md:text-7xl"
        >
          Carlos Ulloque
        </h1>
        <p class="mt-7 max-w-2xl text-lg leading-8 text-ink-muted">
          Engineering for systems where downtime, data loss, and recovery time
          have real consequences. The work here covers operating Oracle
          infrastructure under pressure, designing for graceful degradation, and
          keeping trust and exposure deliberately small.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <ButtonLink href="/notes">Read technical notes</ButtonLink>
          <ButtonLink href="/projects" variant="secondary"
            >View projects</ButtonLink
          >
        </div>
        <div
          class="mt-7 flex flex-wrap gap-x-5 gap-y-2 font-mono text-xs uppercase tracking-[0.16em] text-ink-muted"
        >
          <a href="/about">About</a>
          <a href="/labs">Labs</a>
          <a href="/uses">Uses</a>
        </div>
      </div>

      <div class="home-terminal">
        <TerminalPanel
          title="ulloque.engineering"
          lines={[
            'identity: Carlos Ulloque',
            'role: Mission Critical Engineer',
            'systems: Oracle · Exadata · RAC · ZDLRA',
            'security: Cloudflare Access · privacy-aware design',
            'product: encrypted systems · useful tools',
          ]}
        />
      </div>
    </section>

    <section class="home-section mt-10">
      <SectionHeading
        eyebrow="Focus areas"
        title="What the work focuses on"
        description="Practical engineering, shared without exposing private systems, clients, or personal data."
      />
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {
          focusAreas.map((area) => (
            <Panel eyebrow="Focus" title={area.title}>
              <p>{area.description}</p>
            </Panel>
          ))
        }
      </div>
    </section>

    <section class="home-section mt-24">
      <SectionHeading
        eyebrow="Recent notes"
        title="Field notes from operating real systems"
        description="Oracle infrastructure, recovery, and access control — written from incidents and operations, not theory."
      />
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {recentNotes.map((note) => <LinkCard {...note} />)}
      </div>
    </section>

    <section class="home-section mt-24">
      <SectionHeading
        eyebrow="Featured projects"
        title="Projects built to reduce trust and exposure"
        description="Architecture concepts that keep central trust minimal and responsibilities isolated. Experiments stay separate, in labs."
      />
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {featuredProjects.map((project) => <LinkCard {...project} />)}
      </div>
    </section>

    <section
      class="home-section mt-24 grid gap-5 lg:grid-cols-[0.9fr_1.1fr] lg:items-start"
    >
      <SectionHeading
        eyebrow="Philosophy"
        title="Failure modes come first"
        description="Principles from operating systems where degradation and recovery have consequences."
      />
      <Panel title="Operating principles">
        <ul class="space-y-3 text-sm leading-6">
          <li>Decide how it fails before deciding how it scales.</li>
          <li>
            Keep controls simple enough to operate correctly at 3AM, under
            pressure.
          </li>
          <li>
            Reduce surface area and complexity — smaller blast radius, fewer
            surprises.
          </li>
          <li>
            Favor recovery and predictable behavior over theoretical
            completeness.
          </li>
        </ul>
      </Panel>
    </section>
  </div>
</BaseLayout>
