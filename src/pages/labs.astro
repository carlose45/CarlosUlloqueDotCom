---
import TagList from '../components/content/TagList.astro';
import Panel from '../components/ui/Panel.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { entrySlug, getPublishedEntries } from '../lib/content';

const labs = await getPublishedEntries('labs');
---

<BaseLayout
  title="Labs"
  description="Experimental engineering labs from Carlos Ulloque covering Zero Trust access patterns, client-side encryption, observability, and infrastructure automation."
>
  <p class="font-mono text-sm uppercase tracking-[0.18em] text-signal">
    Experiments
  </p>
  <h1 class="mt-4 text-4xl font-semibold text-ink-text">Labs</h1>
  <p class="mt-4 max-w-3xl text-lg leading-8 text-ink-muted">
    Experimental engineering concepts and prototypes separated from polished
    projects.
  </p>

  <div class="mt-10 grid gap-4 md:grid-cols-2">
    {
      labs.map((lab) => (
        <a href={`/labs/${entrySlug(lab)}/`} class="block h-full">
          <Panel eyebrow={lab.data.status} title={lab.data.title}>
            <p>{lab.data.description}</p>
            <div class="mt-5">
              <TagList tags={lab.data.tags} />
            </div>
          </Panel>
        </a>
      ))
    }
  </div>
</BaseLayout>
