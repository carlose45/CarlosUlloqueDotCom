---
import TagList from '../components/content/TagList.astro';
import Panel from '../components/ui/Panel.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { entrySlug, getPublicEntries, getReadingTime } from '../lib/content';

const notes = await getPublicEntries('notes');
---

<BaseLayout
  title="Notes"
  description="Operational notes by Carlos Ulloque on Oracle infrastructure, recovery, and access control — troubleshooting written from production systems."
>
  <p class="font-mono text-sm uppercase tracking-[0.18em] text-signal">
    Operational notes
  </p>
  <h1 class="mt-4 text-4xl font-semibold text-ink-text">Notes</h1>
  <p class="mt-4 max-w-3xl text-lg leading-8 text-ink-muted">
    Notes from running production systems: troubleshooting, recovery, and the
    checks that remove ambiguity under pressure. Written down so the same
    incident does not have to be solved twice.
  </p>

  <div class="mt-10 grid gap-4 md:grid-cols-2">
    {
      notes.map((note) => (
        <a href={`/notes/${entrySlug(note)}/`} class="block h-full">
          <Panel eyebrow={note.data.category} title={note.data.title}>
            <p>{note.data.description}</p>
            <div class="mt-5">
              <TagList tags={note.data.tags} />
            </div>
            <p class="mt-4 font-mono text-xs uppercase tracking-[0.16em] text-signal">
              {getReadingTime(note)} ·{' '}
              {note.data.publishDate.toLocaleDateString('en-US')}
            </p>
          </Panel>
        </a>
      ))
    }
  </div>
</BaseLayout>
