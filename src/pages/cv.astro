---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Private CV | Carlos Ulloque">
  <Fragment slot="head">
    <meta name="robots" content="noindex,nofollow" />
  </Fragment>
  <h1 class="text-4xl font-semibold text-white">Private CV</h1>
  <p class="mt-4 max-w-2xl text-slate-300">
    This route is reserved for future protected access and does not publish
    sensitive CV details.
  </p>
</BaseLayout>
