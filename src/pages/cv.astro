---
import BaseLayout from '../layouts/BaseLayout.astro';
import Panel from '../components/ui/Panel.astro';
---

<BaseLayout
  title="Private CV"
  description="Private CV access placeholder for Carlos Ulloque. This page is reserved for future protected access."
  noindex
>
  <p class="font-mono text-sm uppercase tracking-[0.18em] text-signal">
    Protected route
  </p>
  <h1 class="mt-4 text-4xl font-semibold text-ink-text">Private CV</h1>
  <div class="mt-10 max-w-3xl">
    <Panel title="Access placeholder">
      <p>
        This route is reserved for future protected access and does not publish
        sensitive CV details.
      </p>
    </Panel>
  </div>
</BaseLayout>
