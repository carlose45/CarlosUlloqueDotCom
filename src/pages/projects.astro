---
import Panel from '../components/ui/Panel.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedEntries } from '../lib/content';

const projects = await getPublishedEntries('projects');
---

<BaseLayout
  title="Projects"
  description="Engineering projects and architecture writeups from Carlos Ulloque, focused on security, infrastructure, and product engineering."
>
  <p class="font-mono text-sm uppercase tracking-[0.18em] text-signal">
    Proof of work
  </p>
  <h1 class="mt-4 text-4xl font-semibold text-ink-text">Projects</h1>
  <p class="mt-4 max-w-3xl text-lg leading-8 text-ink-muted">
    Engineering projects and architecture writeups, backed by typed content
    collections.
  </p>

  <div class="mt-10 grid gap-4 md:grid-cols-2">
    {
      projects.map((project) => (
        <Panel eyebrow={project.data.status} title={project.data.title}>
          <p>{project.data.description}</p>
          <p class="mt-4 font-mono text-xs uppercase tracking-[0.16em] text-signal">
            {project.data.technologies.join(' · ')}
          </p>
        </Panel>
      ))
    }
  </div>
</BaseLayout>
