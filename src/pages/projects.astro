---
import TagList from '../components/content/TagList.astro';
import Panel from '../components/ui/Panel.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { entrySlug, getPublicEntries } from '../lib/content';

const projects = await getPublicEntries('projects');
const featured = projects.filter((project) => project.data.featured);
const standard = projects.filter((project) => !project.data.featured);
---

<BaseLayout
  title="Projects"
  description="Engineering projects and architecture writeups from Carlos Ulloque, focused on security, infrastructure, and product engineering."
>
  <p class="font-mono text-sm uppercase tracking-[0.18em] text-signal">
    Proof of work
  </p>
  <h1 class="mt-4 text-4xl font-semibold text-ink-text">Projects</h1>
  <p class="mt-4 max-w-3xl text-lg leading-8 text-ink-muted">
    Engineering projects and architecture writeups, backed by typed content
    collections.
  </p>

  {
    featured.length > 0 && (
      <section class="mt-10">
        <h2 class="text-2xl font-semibold text-ink-text">Featured</h2>
        <div class="mt-5 grid gap-4 md:grid-cols-2">
          {featured.map((project) => (
            <a href={`/projects/${entrySlug(project)}/`} class="block h-full">
              <Panel eyebrow={project.data.status} title={project.data.title}>
                <p>{project.data.description}</p>
                <div class="mt-5">
                  <TagList tags={project.data.technologies} />
                </div>
              </Panel>
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    standard.length > 0 && (
      <section class="mt-12">
        <h2 class="text-2xl font-semibold text-ink-text">All projects</h2>
        <div class="mt-5 grid gap-4 md:grid-cols-2">
          {standard.map((project) => (
            <a href={`/projects/${entrySlug(project)}/`} class="block h-full">
              <Panel eyebrow={project.data.status} title={project.data.title}>
                <p>{project.data.description}</p>
                <div class="mt-5">
                  <TagList tags={project.data.tags} />
                </div>
              </Panel>
            </a>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
