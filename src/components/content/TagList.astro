---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<ul class="flex flex-wrap gap-2" aria-label="Tags">
  {
    tags.map((tag) => (
      <li class="border border-ink-line bg-ink-soft px-2.5 py-1 font-mono text-xs text-ink-muted">
        {tag}
      </li>
    ))
  }
</ul>
