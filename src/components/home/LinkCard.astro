---
interface Props {
  href: string;
  eyebrow: string;
  title: string;
  description: string;
}

const { href, eyebrow, title, description } = Astro.props;
---

<a
  href={href}
  class="group block h-full border border-ink-line bg-ink-panel/72 p-5 transition-colors hover:border-signal/55 hover:bg-ink-panel"
>
  <p class="font-mono text-xs uppercase tracking-[0.18em] text-signal">
    {eyebrow}
  </p>
  <h3 class="mt-3 text-lg font-semibold text-ink-text group-hover:text-signal">
    {title}
  </h3>
  <p class="mt-3 text-sm leading-6 text-ink-muted">{description}</p>
</a>
