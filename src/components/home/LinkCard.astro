---
interface Props {
  href: string;
  eyebrow: string;
  title: string;
  description: string;
}

const { href, eyebrow, title, description } = Astro.props;
---

<a
  href={href}
  class="tron-frame group block h-full border border-ink-line bg-ink-panel/72 bg-[linear-gradient(135deg,rgba(31,111,235,0.09),transparent_38%),linear-gradient(180deg,rgba(13,20,28,0.9),rgba(5,7,10,0.78))] p-5 shadow-[0_24px_70px_rgba(0,0,0,0.22)] transition-colors hover:border-signal/55 hover:bg-ink-panel hover:shadow-[0_0_34px_rgba(45,212,191,0.12),0_24px_70px_rgba(0,0,0,0.24)]"
>
  <p class="font-mono text-xs uppercase tracking-[0.18em] text-signal">
    {eyebrow}
  </p>
  <h3 class="mt-3 text-lg font-semibold text-ink-text group-hover:text-signal">
    {title}
  </h3>
  <p class="mt-3 text-sm leading-6 text-ink-muted">{description}</p>
</a>
