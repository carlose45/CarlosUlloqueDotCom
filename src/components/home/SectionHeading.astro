---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="max-w-3xl">
  <p class="font-mono text-xs uppercase tracking-[0.18em] text-signal">
    {eyebrow}
  </p>
  <h2 class="mt-3 text-2xl font-semibold text-ink-text md:text-3xl">{title}</h2>
  {
    description && (
      <p class="mt-4 text-base leading-7 text-ink-muted">{description}</p>
    )
  }
</div>
