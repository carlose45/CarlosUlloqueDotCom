---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
}

const { href, variant = 'primary' } = Astro.props;
---

<a
  href={href}
  class:list={[
    'cinema-cut inline-flex min-h-11 items-center justify-center border px-5 py-2 font-mono text-sm font-semibold transition-colors focus-visible:outline-signal',
    variant === 'primary' &&
      'border-signal/60 bg-signal/10 text-signal shadow-[0_0_30px_rgba(45,212,191,0.14)] hover:bg-signal/15 hover:shadow-[0_0_38px_rgba(45,212,191,0.24)]',
    variant === 'secondary' &&
      'border-ink-line bg-ink-panel/78 text-ink-text hover:border-line/70 hover:text-signal',
  ]}
>
  <slot />
</a>
