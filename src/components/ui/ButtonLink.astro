---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
}

const { href, variant = 'primary' } = Astro.props;
---

<a
  href={href}
  class:list={[
    'inline-flex min-h-11 items-center justify-center border px-4 py-2 font-mono text-sm font-semibold transition-colors focus-visible:outline-signal',
    variant === 'primary' &&
      'border-signal/70 bg-signal/10 text-signal shadow-[0_0_28px_rgba(45,212,191,0.12)] hover:bg-signal/15',
    variant === 'secondary' &&
      'border-ink-line bg-ink-panel text-ink-text hover:border-line/70 hover:text-signal',
  ]}
>
  <slot />
</a>
