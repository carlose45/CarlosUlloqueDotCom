---
interface Props {
  title?: string;
  lines?: string[];
}

const { title = 'system.status', lines = [] } = Astro.props;
---

<aside
  aria-label={title}
  class="tron-frame terminal-grid overflow-hidden border border-signal/35 shadow-[0_0_55px_rgba(45,212,191,0.16),0_34px_90px_rgba(0,0,0,0.34)] lg:scale-[1.03]"
>
  <div
    class="relative z-10 flex items-center justify-between border-b border-signal/20 bg-ink-soft/72 px-5 py-4"
  >
    <p class="font-mono text-xs uppercase tracking-[0.22em] text-signal">
      {title}
    </p>
    <div class="flex gap-1.5" aria-hidden="true">
      <span class="h-3 w-1 bg-line/80 shadow-[0_0_14px_rgba(31,111,235,0.62)]"
      ></span>
      <span class="h-3 w-1 bg-signal/80 shadow-[0_0_14px_rgba(45,212,191,0.62)]"
      ></span>
      <span class="h-3 w-1 bg-ink-muted/80"></span>
    </div>
  </div>
  <div
    class="relative z-10 space-y-3 px-5 py-6 font-mono text-sm leading-7 text-ink-muted md:px-6 md:py-7 md:text-base"
  >
    {
      lines.length > 0 ? (
        lines.map((line) => (
          <p class="drop-shadow-[0_0_12px_rgba(45,212,191,0.16)]">
            <span class="mr-2 text-signal">&gt;</span> {line}
          </p>
        ))
      ) : (
        <slot />
      )
    }
    <span
      class="cursor-pulse mt-4 block h-1.5 w-4 bg-signal shadow-[0_0_18px_rgba(45,212,191,0.72)]"
      aria-hidden="true"></span>
  </div>
</aside>
