---
interface Props {
  eyebrow?: string;
  title?: string;
}

const { eyebrow, title } = Astro.props;
---

<section
  class="tron-frame h-full border border-ink-line bg-ink-panel/72 bg-[linear-gradient(135deg,rgba(45,212,191,0.075),transparent_42%),linear-gradient(180deg,rgba(13,20,28,0.9),rgba(5,7,10,0.78))] p-5 shadow-[0_24px_70px_rgba(0,0,0,0.24)]"
>
  {
    eyebrow && (
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-signal">
        {eyebrow}
      </p>
    )
  }
  {title && <h2 class="mt-3 text-xl font-semibold text-ink-text">{title}</h2>}
  <div class:list={[eyebrow || title ? 'mt-4' : '', 'text-ink-muted']}>
    <slot />
  </div>
</section>
